# Normalize text files to LF in the repo; let Git pick native endings on checkout.
* text=auto

# Launcher scripts must keep LF endings on every platform. run.sh breaks with
# CRLF, and both launchers are validated as pure-ASCII/LF (see docs/troubleshooting.md).
*.sh text eol=lf
*.bat text eol=lf

# Lockfile is generated; keep diffs quiet.
uv.lock linguist-generated=true

# The interface source and the built bundle are LF in every checkout. Vite
# copies frontend/index.html into the bundle as it is, so a Windows checkout
# with CRLF made the committed bundle differ from CI's Linux build (and git
# does not normalize a file with mixed line endings).
frontend/** text eol=lf
finance_redactor/presentation/static/** text eol=lf

# The built UI bundle is generated by `just web-build` (source in frontend/).
# It is committed so end users need no Node; CI checks it matches the source.
finance_redactor/presentation/static/** linguist-generated=true
frontend/package-lock.json linguist-generated=true
